# Core
ENVIRONMENT=development
JWT_SECRET=1NUvBhDorYBZsGMSbr62PFIyOo0AibVISsDKQ9zWxOY
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# PostgreSQL / pgvector (Docker defaults shown)
POSTGRES_DB=peda
POSTGRES_USER=peda
POSTGRES_PASSWORD=KlwDkEav2oP7L8CF61hjQBZz
DATABASE_URL=postgresql+psycopg://peda:KlwDkEav2oP7L8CF61hjQBZz@postgres:5432/peda

# AI provider abstraction
# Live public data works without AI keys. If keys are absent, the app uses a
# deterministic grounded fallback over the synchronized database.
AI_PROVIDER=groq
AI_MODE=live
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Live public data
DATA_MODE=live
DATA_SYNC_ON_STARTUP=true
DATA_BACKGROUND_REFRESH=true
DATA_REFRESH_HOURS=12
GASTAT_HEADLINES_ENABLED=true
GASTAT_REFRESH_MINUTES=30
LIVE_DATA_START_YEAR=2000
LIVE_DATA_COUNTRY=SAU
DATA_SYNC_TIMEOUT_SECONDS=20

# Safety / runtime
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
SQL_TIMEOUT_MS=3000
SQL_ROW_LIMIT=200
RATE_LIMIT_PER_MINUTE=90
MAX_REQUEST_BYTES=2097152
COOKIE_SECURE=false
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
